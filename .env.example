APP_ENV=dev
APP_DEBUG=true

# Chaves de Criptografia (OBRIGATÓRIO)
# Gere uma chave com: openssl rand -base64 32
APP_KEY=base32:CHAVE_DE_32_BYTES_AQUI
APP_ENCRYPTION_KEY=base32:CHAVE_DE_32_BYTES_AQUI

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Configurações de E-mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-app
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=seu-email@gmail.com
MAIL_FROM_NAME="ERP InLaudo"

# Integração Asaas (Pagamentos)
# Ambiente: sandbox (testes) ou production (produção)
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=sua_api_key_aqui

# Para obter a API Key:
# 1. Acesse https://sandbox.asaas.com/ (testes) ou https://asaas.com/ (produção)
# 2. Faça login ou crie uma conta
# 3. Vá em Configurações > Chaves de API
# 4. Copie a chave e cole aqui

# URL da Aplicação
APP_URL=http://localhost

# Cron Jobs (Alertas Automáticos por E-mail)
# Gere uma chave segura com: openssl rand -hex 32
# Uso: GET https://erp.inlaudo.com.br/api/cron/alertas?key=SUA_CRON_KEY
CRON_KEY=gere_uma_chave_segura_aqui

# OCR — Módulo RDV (Registro de Despesas de Viagem)
# O motor primário (Tesseract.js) roda 100% no navegador do usuário — sem
# custo e sem chave de API. As variáveis abaixo configuram fallbacks OPCIONAIS
# no servidor, usados apenas quando o Tesseract.js não obtém confiança/campos
# suficientes. Sem nenhuma delas configurada, o OCR continua funcionando
# apenas com Tesseract.js.

# OCR.space — gratuito (25.000 requisições/mês). Obtenha uma chave em:
# https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=

# OpenAI Vision — fallback opcional e PAGO. Chave em:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Ordem dos motores de fallback executados no servidor (separados por vírgula).
# Motores sem chave configurada são pulados automaticamente.
RDV_OCR_ENGINES=ocrspace,openai


# Painel SaaS (control-plane)
# Após executar a migration, use o ID do tenant imagiflow-saas-admin retornado na validação.
SAAS_CONTROL_TENANT_ID=
# Domínio-base usado para sugerir subdomínios de novas empresas.
SAAS_TENANT_BASE_DOMAIN=imagiflow.com.br
